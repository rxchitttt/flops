# ─────────────────────────────────────────────────────────────────
# AQI Project — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────

# ── OpenAQ (required for live ingestion) ─────────────────────────
# Free API key: https://explore.openaq.org/register
OPENAQ_API_KEY=your_openaq_api_key_here

# Comma-separated OpenAQ location IDs for your city.
# Run: python scripts/discover_stations.py  to find these.
OPENAQ_LOCATION_IDS=

# ── City scope ────────────────────────────────────────────────────
CITY_NAME=Bengaluru
CITY_LAT=12.9716
CITY_LON=77.5946

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=aqi_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=aqi_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── MLflow ────────────────────────────────────────────────────────
# Leave blank to use a local ./mlruns file store (no server needed).
# Set to http://localhost:5001 when using docker compose up -d mlflow.
MLFLOW_TRACKING_URI=
